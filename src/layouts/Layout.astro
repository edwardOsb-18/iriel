---
 import '../styles/global.css' 
 import { Font } from "astro:assets";

 const url = "https://iriel.vercel.app/";
const imagen = new URL(
  "/imagenes/wha.jpg",
  url
).href;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon"  href="/imagenes/irielportada.png" />
		
		    <Font cssVariable="--font-quicksand" />
			
	    <Font cssVariable="--font-fredoka" />
		 <!-- SEO básico -->
  <title>¡Celebremos el cumpleaños de Iriel! 🎂💖</title>

  <meta
    name="description"
    content="🌸¡Celebremos el cumpleaños de Iriel! 🎂💖 Acompáñanos a compartir un día lleno de alegría, amor, sorpresas y momentos inolvidables. ¡Te esperamos! 🥳💕"
  />

  <meta name="robots" content="index, follow" />

  <!-- URL canónica: reemplaza por la URL real -->
  <!-- <link
    rel="canonical"
    href="https://tudominio.com/cumpleanos-de-iriel/"
  /> -->

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta
    property="og:title"
    content="¡Celebremos el cumpleaños de Iriel! 🎂💖"
  />
  <meta
    property="og:description"
    content="Acompáñanos a compartir un día lleno de alegría, amor, sorpresas y momentos inolvidables. ¡Te esperamos para celebrar juntos! 🥳💕"
  />
  

  <meta property="og:url" content={url} />
<meta property="og:image" content={imagen} />
<meta
  property="og:image:alt"
  content="Invitación al cumpleaños de Iriel"
/>
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="632" />
<meta property="og:locale" content="es_PE" />

  <meta property="og:locale" content="es_PE" />
  <meta property="og:site_name" content="Cumpleaños de Iriel" />

  <!-- Schema.org: evento de cumpleaños -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Event",
    "name": "Cumpleaños de Iriel",
    "description": "Celebremos el cumpleaños de Iriel. Acompáñanos a compartir un día lleno de alegría, amor, sorpresas y momentos inolvidables.",
    "image": [
      "https://iriel.vercel.app/imagenes/open2.jpg"
    ],
   "startDate": "2026-11-14T17:30:00-05:00",
    "eventStatus": "https://schema.org/EventScheduled",
    "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
    "location": {
      "@type": "Place",
      "name": "IDDP EMMANUEL",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Ciudad",
        "addressCountry": "PE"
      }
    }
  }
  </script>
	</head>
	<body class="flex items-center justify-center min-h-screen p-1 ">
		
				<slot />
	
		
	</body>
</html>

<style>

	body{
		  background-image: url(/imagenes/fondo2.webp);
            background-repeat: no-repeat;
            background-size: cover;
			
	}
</style>

