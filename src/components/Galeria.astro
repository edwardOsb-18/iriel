---
import 'photoswipe/style.css';
---


<div class="max-w-[1200px] mx-auto" >



<video src="/imagenes/video/inicio.mp4" class="video mb-[4rem] mx-auto" loop muted autoplay controls playsinline></video>



<h2 class="text-[#a0522d] my-[1rem] text-[1.2rem]">hagan click a cualquier imagen para agrandar las 📷</h2>
<div class="pswp-gallery pswp-gallery--single-column gallery " id="my-gallery">

<div class="as"><video src="/imagenes/video/vi3.mp4" class="video  h-full w-full" loop muted autoplay playsinline></video></div>

{Array.from({length:25}).map((_,i)=>{
let s=i+1

if(s===6||s===7||s===8||s===10||s===17||s===18||s===19||s===20||s===21||s===23||s===24||s===25)
 return (<a href={`/imagenes/fiesta/${s}.webp`} data-pswp-width="1280" data-pswp-height="960" data-cropped="true" target="_blank">
    <img src={`/imagenes/fiesta/${s}-poster.webp`} loading="lazy" alt="">
  </a>)

  else{

    return (<a href={`/imagenes/fiesta/${s}.webp`} data-pswp-width="960" data-pswp-height="1280" data-cropped="true" target="_blank">
    <img src={`/imagenes/fiesta/${s}-poster.webp`} loading="lazy" alt="">
  </a>)
}

})} 






  
</div>




<video src="/imagenes/video/vid.mp4" class="video my-[3rem]" loop muted autoplay playsinline></video>

</div>

<script >
import PhotoSwipeLightbox from 'photoswipe/lightbox';

import MiniMasonry from "minimasonry";




const lightbox = new PhotoSwipeLightbox({
  gallery: '#my-gallery',
  children: 'a',
  pswpModule: () => import('photoswipe')
});
lightbox.init();
</script>

<style> 
.as{
  grid-row: 1/span 3;
}
  .video {
    margin-inline: auto;
    border-radius: 1.5rem;
  mask-image: linear-gradient(
    to bottom,
    black 80%,
    transparent 100%
  );}





.gallery {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  grid-auto-rows: 80px;
  grid-auto-flow: dense;
  gap: 12px;
}


@media screen and (min-width:1200px){
  .gallery {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  grid-auto-rows: 180px;
  grid-auto-flow: dense;
  gap: 12px;
}
}

.gallery  img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  border-radius: 10px;
}

/* Diferentes alturas */
.gallery a img:nth-child(5n + 1) {
  grid-row: span 3;
}

.gallery a img:nth-child(5n + 2) {
  grid-row: span 2;
}

.gallery a img:nth-child(5n + 3) {
  grid-row: span 4;
}

.gallery a img:nth-child(5n + 4) {
  grid-row: span 2;
}

.gallery a img:nth-child(5n + 5) {
  grid-row: span 3;
}

/* Responsive */
@media (max-width: 768px) {
  .gallery {
    grid-template-columns: repeat(3, 1fr);
  }
}

@media (max-width: 480px) {
  .gallery {
    grid-template-columns: repeat(2, 1fr);
    grid-auto-rows: 70px;
  }
}

</style>