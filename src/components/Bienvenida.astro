@keyframes destellar {
  0%, 100% { opacity: .35; scale: .8; }
  50% { opacity: 1; scale: 1.15; }
}

.estrella {
  animation: destellar 2s ease-in-out infinite;
}



@keyframes balancear {
  0%, 100% { rotate: -6deg; }
  50% { rotate: 6deg; }
}

.globo{
  transform-origin: bottom center;
  animation: balancear 1.8s ease-in-out infinite; 
   

}




@keyframes aparecer {
  0% {
    opacity: 0;
    transform: scale(.3);
  }
  70% {
    opacity: 1;
    transform: scale(1.1);
  }
  100% {
    opacity: 1;
    transform: scale(1);
  }
}

