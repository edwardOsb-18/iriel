    <script> 
    import confetti from "canvas-confetti"

    function lanzarConfeti() {
  const colores = [
    "#ff69b4",
    "#ffd700",
    "#00c2ff",
    "#7cfc00",
    "#a855f7",
  ];

  confetti({
    particleCount: 150,
    spread: 360,
    startVelocity: 45,
    gravity: 0.8,
    ticks: 200,
    origin: { x: 0.5, y: 0.5 },
    colors: colores,
  });

  confetti({
    particleCount: 100,
    spread: 180,
    startVelocity: 55,
    origin: { x: 0.5, y: 0.5 },
    colors: colores,
  });
}


        const entryButton = document.getElementById('entry-button') as HTMLElement;
        const entryScreen = document.getElementById('entry-screen') as HTMLElement;
        const invitationWrapper = document.getElementById('invitation-card-wrapper') as HTMLElement;
        const backgroundMusic = document.getElementById('background-music') as HTMLAudioElement;
        // const scene1 = document.getElementById('scene-1');
        const scene2 = document.getElementById('scene-2') as HTMLButtonElement;

        window.addEventListener('load', () => {
            // Espera 3 segundos antes de cambiar las escenas
            setTimeout(() => {

                    scene2.style.opacity = '1';
            }, 1); // 3 segundos de espera inicial
        });

        const seccionesAnim = document.querySelectorAll<HTMLElement>('.uno, .eeee, .dia, .falta, .mensaje, .galeria');
        const animandoEntrada = new WeakSet<HTMLElement>();

        function mostrarSeccion(el: HTMLElement) {
            el.classList.remove('anim-salida');
            void el.offsetWidth;
            el.classList.add('anim-entrada');
            animandoEntrada.add(el);
        }

        function ocultarSeccion(el: HTMLElement) {
            // el.classList.remove('anim-entrada');
            void el.offsetWidth;
            el.classList.add('anim-salida');
        }

        seccionesAnim.forEach((el) => {
            el.addEventListener('animationend', (evento) => {
                if (evento.target !== el) return;

                if (el.classList.contains('anim-entrada')) {
                    animandoEntrada.delete(el);
                } else if (el.classList.contains('anim-salida')) {
                    el.classList.remove('anim-salida');
                }
            });
        });

        const observerSecciones = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
                const el = entry.target as HTMLElement;

                if (entry.isIntersecting) {
                    if (!el.classList.contains('anim-entrada') || el.classList.contains('anim-salida')) {
                        mostrarSeccion(el);
                    }
                } else if (!animandoEntrada.has(el) && el.classList.contains('anim-entrada')) {
                    ocultarSeccion(el);
                }
            });
        }, { threshold: .25 });

        seccionesAnim.forEach((el) => observerSecciones.observe(el));

        entryButton.addEventListener('click', () => {
            entryScreen.style.display = 'none';
            invitationWrapper.style.display = 'block';
 backgroundMusic.volume=.85
confetti({
  particleCount: 300,
  spread: 360,
  startVelocity: 45,
  origin: {
    x: 0.5,
    y: 0.5,
  },
});
             backgroundMusic.currentTime = 10.2;
             backgroundMusic.play()
        });

        const eventDate = new Date("november 14, 2026 17:30:00").getTime();
        const daysEl = document.getElementById('days') as HTMLElement;
        const hoursEl = document.getElementById('hours') as HTMLElement;
        const minutesEl = document.getElementById('minutes') as HTMLElement;
        const secondsEl = document.getElementById('seconds') as HTMLElement;

         const countdownInterval = setInterval(() => {
             const now = new Date().getTime();
             const distance = eventDate - now;

             if (distance < 0) {
                 clearInterval(countdownInterval);
                 (document.getElementById('countdown') as HTMLElement).innerHTML = "<p class='text-lg text-verde-militar'>¡El día ha llegado!</p>";
                 return;
             }

             daysEl.textContent = String(Math.floor(distance / (1000 * 60 * 60 * 24))).padStart(2, '0');
             hoursEl.textContent = String(Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60))).padStart(2, '0');
             minutesEl.textContent = String(Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60))).padStart(2, '0');
             secondsEl.textContent = String(Math.floor((distance % (1000 * 60)) / 1000)).padStart(2, '0');
         }, 1000);
    </script>


