    <script>
        const entryButton = document.getElementById('entry-button') as HTMLElement;
        const entryScreen = document.getElementById('entry-screen') as HTMLElement;
        const invitationWrapper = document.getElementById('invitation-card-wrapper') as HTMLElement;
        const backgroundMusic = document.getElementById('background-music') as HTMLAudioElement;
        // const scene1 = document.getElementById('scene-1');
        const scene2 = document.getElementById('scene-2') as HTMLButtonElement;

        window.addEventListener('load', () => {
            // Espera 3 segundos antes de cambiar las escenas
            setTimeout(() => {

                    scene2.style.opacity = '1';
            }, 1); // 3 segundos de espera inicial
        });

        entryButton.addEventListener('click', () => {
            entryScreen.style.display = 'none';
            invitationWrapper.style.display = 'block';
// backgroundMusic.volume=.6
//             backgroundMusic.currentTime = 8;
//             backgroundMusic.play().catch(error => {
//                 console.log("La reproducción automática fue bloqueada por el navegador.", error);
//             });
        });

        const eventDate = new Date("november 14, 2026 17:30:00").getTime();
        const daysEl = document.getElementById('days') as HTMLElement;
        const hoursEl = document.getElementById('hours') as HTMLElement;
        const minutesEl = document.getElementById('minutes') as HTMLElement;
        const secondsEl = document.getElementById('seconds') as HTMLElement;

         const countdownInterval = setInterval(() => {
             const now = new Date().getTime();
             const distance = eventDate - now;

             if (distance < 0) {
                 clearInterval(countdownInterval);
                 (document.getElementById('countdown') as HTMLElement).innerHTML = "<p class='text-lg text-verde-militar'>¡El día ha llegado!</p>";
                 return;
             }

             daysEl.textContent = String(Math.floor(distance / (1000 * 60 * 60 * 24))).padStart(2, '0');
             hoursEl.textContent = String(Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60))).padStart(2, '0');
             minutesEl.textContent = String(Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60))).padStart(2, '0');
             secondsEl.textContent = String(Math.floor((distance % (1000 * 60)) / 1000)).padStart(2, '0');
         }, 1000);
    </script>


